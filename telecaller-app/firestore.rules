rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Managerial / admin gate via Firebase Custom Claims only.
    // Scheme: request.auth.token.managerial == true (set via Admin SDK / setManagerialClaim).
    // Break-glass: execution/stamp_managerial_claims.py — NOT client-writable Firestore docs.
    // users/1 has no security meaning.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.managerial == true;
    }

    // Clients must never create/change the password field on users.
    function passwordFieldNotTouched() {
      return resource == null
        ? !('password' in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['password']);
    }

    // Fields that escalate privileges — blocked on self-update.
    function selfUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'email', 'isMigrated', 'updatedAt',
        'fcmToken', 'fcmTokenUpdatedAt'
      ]);
    }

    // Map Firestore users/{docId} to the signed-in Auth uid (doc id or linked uid field).
    function userDocUidMatchesAuth(userDocId) {
      return userDocId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(userDocId)) &&
         get(/databases/$(database)/documents/users/$(userDocId)).data.uid == request.auth.uid);
    }

    function isManagerialRoleCode(roleCode) {
      return roleCode in ['admin', 'upper_management', 'middle_management', 'lower_management'];
    }

    // Managerial recipient lookup for notification workflows (agent → manager alerts).
    function userDocIsManagerial(userDocId) {
      return exists(/databases/$(database)/documents/users/$(userDocId)) &&
        (
          isManagerialRoleCode(get(/databases/$(database)/documents/users/$(userDocId)).data.role) ||
          (
            exists(/databases/$(database)/documents/customRoles/$(get(/databases/$(database)/documents/users/$(userDocId)).data.role)) &&
            get(/databases/$(database)/documents/customRoles/$(get(/databases/$(database)/documents/users/$(userDocId)).data.role)).data.isManagerial == true
          )
        );
    }

    function leadDataAssignedToCaller(leadData) {
      return leadData != null &&
        'assignedTo' in leadData &&
        leadData.assignedTo != null &&
        leadData.assignedTo != "" &&
        userDocUidMatchesAuth(leadData.assignedTo);
    }

    function leadOwnedByCaller() {
      return resource != null && leadDataAssignedToCaller(resource.data);
    }

    function leadIdOwnedByCaller(leadId) {
      return exists(/databases/$(database)/documents/leads/$(leadId)) &&
        leadDataAssignedToCaller(get(/databases/$(database)/documents/leads/$(leadId)).data);
    }

    function leadIsUnassigned(leadData) {
      return leadData == null ||
        !('assignedTo' in leadData) ||
        leadData.assignedTo == null ||
        leadData.assignedTo == '' ||
        leadData.assignedTo == 'Unassigned';
    }

    // SEC-1 CLOSED: managerial reads all; agents read own assignedToUid or unassigned pool.
    function leadReadableByCaller() {
      return isAdmin() ||
        (resource != null && resource.data.assignedToUid == request.auth.uid) ||
        (resource != null && leadIsUnassigned(resource.data));
    }

    function leadIdReadableByCaller(leadId) {
      return isAdmin() ||
        (
          exists(/databases/$(database)/documents/leads/$(leadId)) &&
          (
            get(/databases/$(database)/documents/leads/$(leadId)).data.assignedToUid == request.auth.uid ||
            leadIsUnassigned(get(/databases/$(database)/documents/leads/$(leadId)).data)
          )
        );
    }

    function attendanceOwnedByCaller() {
      return resource != null &&
        'userId' in resource.data &&
        userDocUidMatchesAuth(resource.data.userId);
    }

    function conversationReadableByCaller() {
      return isAdmin() ||
        (
          resource != null &&
          'assignedTo' in resource.data &&
          resource.data.assignedTo != null &&
          resource.data.assignedTo != '' &&
          userDocUidMatchesAuth(resource.data.assignedTo)
        ) ||
        (
          resource != null &&
          'leadId' in resource.data &&
          resource.data.leadId is string &&
          leadIdReadableByCaller(resource.data.leadId)
        );
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection:
    // - Least-privilege read (SEC-1): managerial read all; everyone else reads only
    //   their own profile. Self-match by linked uid, or by token email for the
    //   login / JIT-link path where the uid field is not yet stamped.
    // - Only claim-holders (isAdmin) can create or delete users.
    // - Self-update: already-linked profile only; no uid/password/role/permission fields.
    // - password field: never creatable/updatable from clients (use Auth + Admin SDK).
    match /users/{userId} {
      allow read: if isAdmin()
        || (isAuthenticated() && 'uid' in resource.data && resource.data.uid == request.auth.uid)
        || (isAuthenticated() && 'email' in resource.data && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && passwordFieldNotTouched();
      allow delete: if isAdmin();
      allow update: if passwordFieldNotTouched() && (
        isAdmin() || (
          isAuthenticated() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          selfUpdateKeysAllowed()
        )
      );
    }

    match /userRoles/{uid} {
      allow read: if isAuthenticated();
      // Admins can create/update/delete any role mapping
      allow update, delete: if isAdmin();
      // Users can only create their own role mapping if it doesn't exist yet, and it must be non-managerial
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == uid &&
        exists(/databases/$(database)/documents/customRoles/$(request.resource.data.role)) &&
        get(/databases/$(database)/documents/customRoles/$(request.resource.data.role)).data.isManagerial != true
      );
    }

    match /customRoles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /deletedUsers/{username} {
      allow read, write: if isAdmin();
    }

    // Settings collection:
    // - branding is public-read so login / boot screens can theme before auth
    // - other settings: authenticated read EXCEPT integrations_secrets (admin-only)
    // - Write allowed only for admins
    match /settings/{settingId} {
      allow read: if settingId == 'branding'
        || (isAuthenticated() && (settingId != 'integrations_secrets' || isAdmin()));
      allow write: if isAdmin();
    }

    // Projects:
    // - Read allowed for authenticated users
    // - Write allowed only for admins
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rosters:
    // - Read allowed for authenticated users
    // - Write allowed only for admins
    match /rosters/{rosterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Call Targets:
    // - Read allowed for authenticated users
    // - Write allowed only for admins
    match /callTargets/{targetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Audit Logs:
    // - Read allowed only for admins/managers
    // - Create denied on client (SEC-1) — use logAuditEventCallable / Admin SDK
    // - Update/Delete disabled completely (immutable audit logs)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // Leads:
    // - Read (SEC-1 CLOSED): managerial OR assignedToUid == auth.uid OR unassigned pool.
    //   Requires execution/backfill_assigned_to_uid.py before deploy.
    // - Ownership for write: assigned leads only; unassigned is managerial-only update/delete.
    match /leads/{leadId} {
      allow read: if leadReadableByCaller();

      // Create: non-managerial may not pre-assign a lead to another user (SEC-5).
      allow create: if isAdmin() || (
        isAuthenticated() && (
          !('assignedTo' in request.resource.data) ||
          request.resource.data.assignedTo == "" ||
          userDocUidMatchesAuth(request.resource.data.assignedTo)
        )
      );

      // Update: must own the lead (assigned); unassigned leads are managerial-only.
      // Non-managerial cannot reassign or mutate provenance fields (SEC-5).
      allow update: if isAdmin() || (
        isAuthenticated() &&
        leadOwnedByCaller() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'assignedTo', 'createdBy', 'createdAt', 'leadNumber', 'leadReference'
        ])
      );

      allow delete: if isAdmin() || (isAuthenticated() && leadOwnedByCaller());

      // Legacy WhatsApp messages (read-only compatibility; new writes are server-only)
      match /whatsappMessages/{messageId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          leadIdReadableByCaller(leadId)
        );
        allow create, update: if false;
        allow delete: if isAdmin();
      }

      match /whatsapp/{docId} {
        allow read: if isAdmin() || (
          isAuthenticated() &&
          leadIdReadableByCaller(leadId)
        );
        allow write: if false;
      }
    }

    // Canonical WhatsApp conversations — server-only writes (Admin SDK / Cloud Functions).
    match /whatsappConversations/{conversationId} {
      allow read: if conversationReadableByCaller();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Canonical WhatsApp messages — server-only writes (Admin SDK / Cloud Functions).
    match /whatsappMessages/{messageId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        'leadId' in resource.data &&
        resource.data.leadId is string &&
        leadIdReadableByCaller(resource.data.leadId)
      );
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Canonical CRM activity stream — immutable after create
    match /timelineEvents/{eventId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        'leadId' in resource.data &&
        resource.data.leadId is string &&
        leadIdReadableByCaller(resource.data.leadId)
      );
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Phase C — top-level call log events (not embedded on Lead)
    match /callLogs/{callLogId} {
      allow read: if isAdmin() || (
        isAuthenticated() &&
        resource != null &&
        'leadId' in resource.data &&
        resource.data.leadId is string &&
        leadIdReadableByCaller(resource.data.leadId)
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        'leadId' in request.resource.data &&
        request.resource.data.leadId is string &&
        leadIdOwnedByCaller(request.resource.data.leadId)
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource != null &&
        'leadId' in resource.data &&
        leadIdOwnedByCaller(resource.data.leadId) &&
        request.resource.data.leadId == resource.data.leadId
      );
      allow delete: if isAdmin();
    }

    // Phase C — create-once productivity markers (Cloud Functions write via Admin SDK)
    match /productivityEvents/{callLogId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Archived Leads:
    // - Only admin can read, write
    match /archivedLeads/{leadId} {
      allow read, write: if isAdmin();
    }

    // Productivity:
    // - Reads allowed by authenticated users
    // - Writes allowed for owner user matching userId field in document or admin
    match /agentProductivity/{prodId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (
        isAuthenticated() &&
        (resource == null || resource.data.userId == request.resource.data.userId) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.uid == request.auth.uid
      );
    }

    // Agent Status:
    // - Reads allowed by authenticated users
    // - Writes allowed for the owner of the status document or admin
    match /agentStatus/{statusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        statusId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(statusId)) &&
         get(/databases/$(database)/documents/users/$(statusId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Attendance:
    // - Reads: managerial all; agents own records only (H2)
    // - Writes allowed for the user matching the record's userId or admin
    match /attendance/{attId} {
      allow read: if isAdmin() || attendanceOwnedByCaller();
      allow write: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.uid == request.auth.uid &&
        (resource == null || resource.data.userId == request.resource.data.userId)
      );
    }

    // Leave Requests:
    // - Reads allowed by authenticated users
    // - Create allowed for the user matching the request's userId
    // - Status updates and deletes restricted to admins/managers
    match /leaveRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications:
    // - Reads allowed for recipient (or global broadcasts)
    // - Create (SEC-6R): managerial claim OR self-target OR managerial recipient
    //   (blocks peer telecaller spam; preserves agent→manager workflow alerts).
    // - Update restricted to marking own notifications as read
    // - Delete allowed only for admins
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        !('userId' in resource.data) ||
        resource.data.userId == null ||
        resource.data.userId == "" ||
        resource.data.userId == request.auth.uid ||
        userDocUidMatchesAuth(resource.data.userId)
      );
      allow create: if isAuthenticated()
        && (!('read' in request.resource.data) || request.resource.data.read == false)
        && (
          isAdmin() ||
          (
            'userId' in request.resource.data &&
            request.resource.data.userId != null &&
            request.resource.data.userId != "" &&
            (
              userDocUidMatchesAuth(request.resource.data.userId) ||
              userDocIsManagerial(request.resource.data.userId)
            )
          )
        );
      allow delete: if isAdmin();
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        userDocUidMatchesAuth(resource.data.userId) ||
        isAdmin()
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Themes:
    // - Access restricted to owner or admin
    match /themes/{themeId} {
      allow read, write: if isAuthenticated() && (
        themeId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(themeId)) &&
         get(/databases/$(database)/documents/users/$(themeId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Dashboard Preferences:
    // - Access restricted to owner or admin
    match /dashboardPreferences/{prefId} {
      allow read, write: if isAuthenticated() && (
        prefId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(prefId)) &&
         get(/databases/$(database)/documents/users/$(prefId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
    }

    // IVR Calls:
    // - Auto-ID docs owned via agentId field (legacy: doc id == agent/user id)
    match /ivrCalls/{callId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        callId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(callId)) &&
         get(/databases/$(database)/documents/users/$(callId)).data.uid == request.auth.uid) ||
        (
          'agentId' in resource.data && (
            resource.data.agentId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(resource.data.agentId)) &&
             get(/databases/$(database)/documents/users/$(resource.data.agentId)).data.uid == request.auth.uid)
          )
        )
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          'agentId' in request.resource.data && (
            request.resource.data.agentId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(request.resource.data.agentId)) &&
             get(/databases/$(database)/documents/users/$(request.resource.data.agentId)).data.uid == request.auth.uid)
          )
        )
      );
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        callId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(callId)) &&
         get(/databases/$(database)/documents/users/$(callId)).data.uid == request.auth.uid) ||
        (
          resource != null &&
          'agentId' in resource.data && (
            resource.data.agentId == request.auth.uid ||
            (exists(/databases/$(database)/documents/users/$(resource.data.agentId)) &&
             get(/databases/$(database)/documents/users/$(resource.data.agentId)).data.uid == request.auth.uid)
          )
        )
      );
    }

    // Tasks:
    // - Access restricted to owner or admin
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('userId' in resource.data && exists(/databases/$(database)/documents/users/$(resource.data.userId)) &&
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('userId' in resource.data && exists(/databases/$(database)/documents/users/$(resource.data.userId)) &&
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Teams:
    // - Reads allowed by authenticated users
    // - Writes restricted to admins
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Smart Lists:
    // - Access restricted to owner or admin
    match /smartLists/{listId} {
      allow read: if isAuthenticated() && (
        !('userId' in resource.data) ||
        resource.data.userId == null ||
        resource.data.userId == "" ||
        resource.data.userId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(resource.data.userId)) &&
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        ('userId' in resource.data && resource.data.userId == request.auth.uid) ||
        ('userId' in resource.data && exists(/databases/$(database)/documents/users/$(resource.data.userId)) &&
         get(/databases/$(database)/documents/users/$(resource.data.userId)).data.uid == request.auth.uid) ||
        isAdmin()
      );
    }
  }
}
